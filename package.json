{
  "name": "studio-real",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w conducteur",
    "build": "npm run build -w @studio-real/modele && npm run build -w conducteur",
    "test": "npm test -w @studio-real/modele -w @studio-real/protocole -w @studio-real/serveur-spectacle",
