{
  "name": "studio-real",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w conducteur",
    "build": "npm run build -w @studio-real/modele && npm run build -w conducteur",
    "test": "npm test -w @studio-real/modele -w @studio-real/protocole",
    "verifier-projets": "npm run verifier -w @studio-real/modele",
    "typecheck": "tsc -b",
    "lint": "npm run lint -w conducteur",
    "pages": "npm run pages -w conducteur",
    "dev:spectacle": "node prototypes/figurants/serveur/index.mjs",
    "dev:serveur": "npm run dev -w serveur"
  }
}
