{
  "name": "studio-real",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w conducteur",
    "dev:telephone": "npm run dev -w telephone",
    "build": "npm run build -w @studio-real/modele && npm run build -w conducteur && npm run build -w telephone",
    "test": "vitest run --project modele --project protocole --project conducteur-rapide --project serveur-logique --project figurants --project outils-medias --project outils-banc-media --project serveur-spectacle --project ui-telephone --project emulateur",
    "test:lent": "vitest run --project conducteur-lent --project serveur-integration",
    "test:tout": "vitest run",
    "verifier-projets": "npm run verifier -w @studio-real/modele",
    "fluidite": "node --import tsx outils/fluidite/mesurer.ts",
    "typecheck": "tsc -b",
    "lint": "npm run lint -w conducteur",
    "pages": "npm run pages -w conducteur",
    "dev:spectacle": "npm start -w @studio-real/serveur-spectacle",
    "spectacle": "powershell -NoProfile -File exploitation/lancer-spectacle.ps1",
    "spectacle:arret": "powershell -NoProfile -File exploitation/arreter-spectacle.ps1",
    "dev:figurants": "node prototypes/figurants/serveur/index.mjs",
    "dev:serveur": "npm run dev -w serveur"
  }
}
