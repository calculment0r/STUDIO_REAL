{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "../../node_modules/.cache/tsc/ui-telephone",
    "rootDir": "src",
    "tsBuildInfoFile": "../../node_modules/.cache/tsc/ui-telephone.tsbuildinfo",
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
